SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001

# NetRis — proxy server-side (dump de atendimentos, proxy genérico e baixa do Farol)
NETRIS_BASE_URL=
NETRIS_TOKEN=
