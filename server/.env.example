# Host do PACS (Netris-web) — histórico de situações. Tem default no código.
NETRIS_PACS_BASE_URL=

# Cache do dump de atendimentos. Em dev usa store in-memory automaticamente;
# em produção aponte pra um Redis real.
REDIS_URL=
